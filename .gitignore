# 依赖
node_modules/
.pnpm-store/

# 构建产物：唯一合法目录是 release/（见 docs/发布规范.md 第 9 节）
# out/ 是 electron-vite 的编译中间产物，release/ 是 electron-builder 的打包产物
out/
release/
dist/

# 历史遗留的临时产物目录。正常不该出现；出现说明有人用
# --config.directories.output=xxx 绕过占用，属于违规操作，跑 npm run clean 收拾
release-old/
rel/
rel2/
rel3/

# 图标由 scripts/make-icon.mjs 生成，但 build/icon.ico 需要入库
# （electron-builder 打包时直接读取），因此只忽略临时截图
build/shots/

# 视觉验收用的演示库与临时 userData
.smoke/

# 编辑器 / 系统
.vscode/*
!.vscode/extensions.json
.idea/
*.log
npm-debug.log*
.DS_Store
Thumbs.db
desktop.ini

# 本地环境变量
.env
.env.local

# 打包产出物（体积大，不进仓库）
*.promptpack

# 本地助手工作目录（项目记忆，不随仓库分发）
.workbuddy/
.zcode/

# 本地打包目录（体积大，不进仓库）
rel2/
